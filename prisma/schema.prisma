generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Report {
  id           String    @id @default(cuid())
  slug         String    @unique
  clientName   String
  clientEmail  String?
  passwordHash      String
  clientPasswordPlain String?
  isActive      Boolean   @default(true)
  viewCount     Int       @default(0)
  lastViewedAt  DateTime?
  clientProfile Json?
  adminProfile  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sections  ReportSection[]
  documents ClientDocument[]
  comments  PortalComment[]
  events    PortalEvent[]
  sessions  PortalSession[]

  @@map("reports")
}

model PortalComment {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  context   String   @default("general") // "general" | "section:<id>" | "doc:<id>"
  author    String
  text      String
  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("portal_comments")
}

model PortalEvent {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  eventType String   // "tab_view" | "doc_open" | "section_expand" | "comment_add" | "file_submit"
  meta      Json?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([eventType])
  @@map("portal_events")
}

model PortalSession {
  id            String   @id @default(cuid())
  reportId      String
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sessionId     String   @unique
  ip            String?
  country       String?
  countryCode   String?
  city          String?
  device        String?
  browser       String?
  totalDuration Int      @default(0)
  startedAt     DateTime @default(now())
  lastActiveAt  DateTime @default(now())

  @@index([reportId])
  @@map("portal_sessions")
}

model ReportSection {
  id           String   @id @default(cuid())
  reportId     String
  sectionType  String
  title        String
  content      Json
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_sections")
}

model ClientDocument {
  id         String   @id @default(cuid())
  reportId   String
  docType    String
  title      String
  url        String
  notes      String?
  uploadedAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("client_documents")
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String
  tags         String[]
  imageUrl     String?
  liveUrl      String?
  stats        Json?
  featured     Boolean  @default(false)
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}

model Testimonial {
  id           String   @id @default(cuid())
  clientName   String
  role         String?
  company      String?
  quote        String
  projectName  String?
  rating       Int      @default(5)
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("testimonials")
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String?
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("faqs")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model SocialLink {
  id           String  @id @default(cuid())
  platform     String
  url          String
  handle       String?
  isVisible    Boolean @default(true)
  displayOrder Int     @default(0)

  @@map("social_links")
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  budget    String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_leads")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// Every push we attempt, so a missed notification can still be found later.
model NotificationLog {
  id        String   @id @default(cuid())
  title     String
  body      String
  url       String
  devices   Int      @default(0) // devices targeted
  delivered Int      @default(0) // how many accepted the push
  failed    Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("notification_logs")
}

// ─── New Client Portal Schema (v2) ───────────────────────────────────────────
// Old models (Report, ReportSection, ClientDocument, PortalComment,
// PortalEvent, PortalSession) are kept intact as backup above.

model Client {
  id              String    @id @default(cuid())
  name            String
  email           String?
  phone           String?
  slug            String    @unique  // portal URL slug, e.g. "kruti-lunawat"
  passwordHash    String
  isActive        Boolean   @default(true)
  clientProfile   Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  projects        ClientProject[]
  storeproofReports StoreProofReport[]

  @@map("clients")
}

model ClientProject {
  id            String    @id @default(cuid())
  clientId      String
  name          String    // e.g. "Shopify Store Build — Phase 1"
  clientType    String    @default("new_build")  // new_build | existing_optimisation | audit_only | retainer | landing_page | migration
  platform      String?                          // shopify | wordpress | woocommerce | webflow | custom | null (null = show all tabs, backward compat)
  status        String    @default("active")     // draft | active | completed
  tabConfig     Json?     // null = use clientType+platform defaults
  adminProfile  Json      @default("{}")          // proposalVisible, notes, etc.
  displayOrder  Int       @default(0)
  viewCount     Int       @default(0)
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sections      ProjectSection[]
  documents     ProjectDocument[]
  comments      ProjectComment[]
  events        ProjectEvent[]
  sessions      ProjectSession[]
  contracts     ProjectContract[]
  milestones    ProjectMilestone[]
  deliverables  ProjectDeliverable[]
  messages      ProjectMessage[]

  @@map("client_projects")
}

model ProjectSection {
  id           String        @id @default(cuid())
  projectId    String
  sectionType  String
  title        String
  content      Json          @default("{}")
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  project      ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_sections")
}

model ProjectDocument {
  id         String        @id @default(cuid())
  projectId  String
  docType    String
  title      String
  url        String
  notes      String?
  approvedAt DateTime?
  approvedBy String?
  uploadedAt DateTime      @default(now())
  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_documents")
}

model ProjectComment {
  id        String        @id @default(cuid())
  projectId String
  context   String        @default("general")
  author    String
  text      String
  createdAt DateTime      @default(now())
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_comments")
}

model ProjectEvent {
  id        String        @id @default(cuid())
  projectId String
  eventType String
  meta      Json          @default("{}")
  sessionId String?
  createdAt DateTime      @default(now())
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_events")
}

model ProjectDocumentLog {
  id         String   @id @default(cuid())
  projectId  String
  documentId String
  action     String   // 'added' | 'url_changed' | 'note_edited' | 'deleted'
  actorType  String   // 'admin' | 'client'
  docTitle   String?
  meta       Json?    // { oldValue?, newValue?, docType? }
  createdAt  DateTime @default(now())

  @@map("project_document_logs")
}

model ProjectContract {
  id              String    @id @default(cuid())
  projectId       String
  phase           Int       @default(1)
  phaseLabel      String?
  content         String    @default("")
  status          String    @default("draft")  // draft | sent | signed
  clientSignature String?
  signedAt        DateTime?
  sentAt          DateTime?
  advancePaid        Boolean   @default(false)
  balancePaid        Boolean   @default(false)
  advanceReceiptUrl  String?
  balanceReceiptUrl  String?
  createdAt          DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, phase])
  @@map("project_contracts")
}

model ProjectMilestone {
  id           String               @id @default(cuid())
  projectId    String
  title        String
  description  String?
  status       String               @default("pending")  // pending | in_progress | completed | blocked
  dueDate      DateTime?
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  project      ClientProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables ProjectDeliverable[]

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectDeliverable {
  id           String               @id @default(cuid())
  projectId    String
  milestoneId  String?
  title        String
  description  String?
  previewUrl     String?
  attachmentUrl  String?
  attachmentName String?
  subTasks       Json               @default("[]")
  status       String               @default("backlog")  // backlog | in_progress | under_review | changes_requested | completed
  addedBy      String               @default("admin")  // admin | client
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  project      ClientProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    ProjectMilestone?    @relation(fields: [milestoneId], references: [id])
  feedback     DeliverableFeedback[]

  @@index([projectId])
  @@map("project_deliverables")
}

model DeliverableFeedback {
  id             String             @id @default(cuid())
  deliverableId  String
  projectId      String
  message        String
  attachmentUrl  String?
  attachmentName String?
  addedBy        String             // "admin" | "client"
  status         String             @default("open")  // open | in_progress | resolved | reopened | wont_fix
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deliverable    ProjectDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  replies        FeedbackReply[]

  @@index([deliverableId])
  @@map("deliverable_feedback")
}

model FeedbackReply {
  id             String              @id @default(cuid())
  feedbackId     String
  message        String
  attachmentUrl  String?
  attachmentName String?
  addedBy        String              // "admin" | "client"
  createdAt      DateTime            @default(now())
  feedback       DeliverableFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@map("feedback_replies")
}

model PortalLead {
  id                String    @id @default(cuid())
  name              String
  email             String
  phone             String?
  businessName      String?
  website           String?
  clientType        String    @default("new_build")
  platform          String?
  message           String?
  status            String    @default("new")   // new | contacted | converted | archived
  convertedClientId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("portal_leads")
}

model ProjectMessage {
  id           String        @id @default(cuid())
  projectId    String
  senderType   String        // 'admin' | 'client'
  text         String
  readByAdmin    Boolean       @default(false)
  readByClient   Boolean       @default(false)
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime      @default(now())
  project      ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_messages")
}

model ProjectSession {
  id            String        @id @default(cuid())
  projectId     String
  sessionId     String        @unique
  ip            String?
  country       String?
  countryCode   String?
  city          String?
  device        String?
  browser       String?
  totalDuration Int           @default(0)
  startedAt     DateTime      @default(now())
  lastActiveAt  DateTime      @default(now())
  project       ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_sessions")
}

model FunnelLead {
  id            String    @id @default(cuid())
  // Stage 1 — VSL opt-in gate
  name          String
  email         String    @unique
  phone         String?
  profession    String?
  // Stage 2 — application form
  whatsapp      String?
  storeUrl      String?
  role          String?
  challenge     String?   // traffic_no_sales | low_conversion | poor_roas | cart_abandonment | brand_mismatch | other
  revenue       String?   // under_5k | 5k_10k | 10k_25k | 25k_50k | over_50k
  blocker       String?   // "Be 100% honest..." free text
  financial     String?   // ready_now | can_invest | budget_challenge
  readiness     String?   // right_now | within_30_days | later
  // Funnel state
  stage         String    @default("optin")   // optin | applied
  status        String    @default("new")     // new | confirmed | call_booked | showed (call done) | proposal_sent | closed_won | closed_lost | disqualified
  // Attribution
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  notes         String?
  formAnswers   Json?     // Instant Form qualifying answers: { "question text": "answer" }
  callScript    String?   // generated SLOSHED call-prep JSON
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]
  auditReports  AuditReport[]
  activities    LeadActivity[]
  proposals     Proposal[]

  @@index([stage])
  @@index([status])
  @@map("funnel_leads")
}

model AuditReport {
  id           String     @id @default(cuid())
  funnelLeadId String
  funnelLead   FunnelLead @relation(fields: [funnelLeadId], references: [id], onDelete: Cascade)
  token        String     @unique @default(cuid())
  storeUrl     String
  status       String     @default("draft") // generating | draft | sent | failed
  reportJson   String     @default("{}")     // full structured audit
  rawData      String?                        // pagespeed + scrape payload for debugging
  error        String?
  sentAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([funnelLeadId])
  @@map("audit_reports")
}

model Booking {
  id            String      @id @default(cuid())
  funnelLeadId  String?
  funnelLead    FunnelLead? @relation(fields: [funnelLeadId], references: [id])
  name          String
  email         String
  whatsapp      String?
  startTime     DateTime
  endTime       DateTime
  timezone      String      @default("Asia/Kolkata")
  googleEventId String?
  meetLink      String?
  status        String      @default("confirmed") // confirmed | cancelled | completed | no_show
  remindersSent String      @default("[]")        // JSON array of sent reminder keys: 12h | 1h | 30m | live
  callSummary   String?     // Fathom: AI summary + action items
  callTranscript String?    // Fathom: full transcript (capped)
  recordingUrl  String?     // Fathom share link
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([startTime])
  @@map("bookings")
}

model FunnelEmailLog {
  id        String   @id @default(cuid())
  email     String
  kind      String   // confirmation | 12h | 1h | 30m | live
  subject   String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("funnel_email_logs")
}

model VideoWatch {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  email          String?
  secondsWatched Int      @default(0) // accumulated real playtime (includes rewatches)
  maxPosition    Int      @default(0) // furthest second reached in the video
  duration       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@map("video_watches")
}

// ─── StoreProof: published Store Health Reports, gated behind the client portal ───

model StoreProofReport {
  id           String    @id @default(cuid())
  host         String    // store hostname, e.g. "thehonestroots.in"
  runStamp     String    // StoreProof run dir timestamp, e.g. "2026-09-12034546"
  storeName    String
  html         String    // sanitized store-health.html (appnav stripped at publish)
  findingsJson String    @default("{}") // { findings: [...], opener: "..." } — teaser email source
  pdfData      Bytes?    // agency-grade report.pdf when published
  clientId     String?   // assignment gates portal access
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  funnelLeadId String?   // CRM link when the store belongs to a funnel lead
  publicToken  String?   @unique // unlocks the PUBLIC blurred teaser at /report/<token>
  publicFull           Boolean  @default(false) // true = /report/<token> shows the FULL report (existing clients), not the blurred teaser
  competitorsRequested String? // comma-separated domains the lead asked to be compared against
  status       String    @default("published") // published | assigned
  viewCount    Int       @default(0)
  firstViewedAt DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  views        StoreProofReportView[]

  @@unique([host, runStamp])
  @@index([clientId])
  @@map("storeproof_reports")
}

model StoreProofReportView {
  id          String           @id @default(cuid())
  reportId    String
  report      StoreProofReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  viewedAt    DateTime         @default(now())
  device      String?
  ip          String?
  durationSec Int?
  scrollPct   Int?
  country     String?
  city        String?
  timezone    String?
  os          String?
  browser     String?
  screen      String?
  referrer    String?
  clicks      String?
  sections    Json?

  @@index([reportId])
  @@map("storeproof_report_views")
}

// Queue for the free-audit funnel: form submit -> job -> Mac worker runs
// StoreProof -> publishes -> lead gets the blurred-report link by email.
model StoreProofJob {
  id           String    @id @default(cuid())
  storeUrl     String
  host         String
  name         String
  email        String
  funnelLeadId String?
  emailLead    Boolean   @default(true) // false = admin-triggered, WhatsApp is the channel
  status       String    @default("queued") // queued | running | done | failed
  error        String?
  attempts     Int       @default(0)
  reportId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([status])
  @@map("storeproof_jobs")
}

// ─── Cold-email prospects (imported from Vela) — QUARANTINED from funnel_leads:
// no automation may email these from the main domain. They cross into
// funnel_leads only when they reply to cold outreach (stage: promoted).

model Prospect {
  id            String    @id @default(cuid())
  velaId        String?   @unique
  email         String    @unique
  name          String?
  company       String?
  country       String?
  storeName     String?
  domain        String?   // store domain (from Vela or derived from email)
  websiteUrl    String?
  firstSeenApp  String?   // which app's review page they were scraped from — intent signal
  productCount  Int?
  reviewCount   Int?
  score         Int?      // Vela's original lead score
  hook          String?   // Vela's original hook line (reference only)
  // Tier ingredients (computed at import)
  geoTier1      Boolean   @default(false) // US / UK / AU / CA
  ownDomain     Boolean   @default(false) // email domain is not freemail
  personalInbox Boolean   @default(false) // localpart isn't info@/support@/...
  croIntent     Boolean   @default(false) // scraped from a CRO-intent app
  tier          String    @default("C")   // A+ | A | B | C
  // Pipeline state
  verifyStatus  String    @default("unverified") // unverified | valid | risky | invalid
  scanStatus    String    @default("pending")    // pending | scanned | failed | skipped
  finding       String?   // the email-1 opener from the tier-1 scan
  issueCount    Int?
  reportId      String?   // StoreProofReport for their pre-built blurred report
  stage         String    @default("new") // new | queued | contacted | replied | promoted | suppressed
  promotedLeadId String?  // funnel_leads id once they reply
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tier])
  @@index([stage])
  @@index([verifyStatus])
  @@index([scanStatus])
  @@map("prospects")
}

// Unified per-lead activity: status changes auto-logged, manual notes added
// from admin/PWA. Rendered merged with email logs, bookings, report views.
model LeadActivity {
  id        String     @id @default(cuid())
  leadId    String
  lead      FunnelLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String     // status | note | system
  text      String
  actor     String?    // who did it (free text: "Rachna", "auto")
  createdAt DateTime   @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// Serverless-safe rate limiting: one row per hit, counted over a window.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// Every Meta leadgen id we've handled — Meta re-delivers old webhook events
// (e.g. ones that failed during an outage), and without this memory a
// re-delivery looked like a brand-new lead (welcome email + "new lead" push).
model MetaLeadEvent {
  leadgenId String   @id
  email     String?
  createdAt DateTime @default(now())

  @@map("meta_lead_events")
}

// Sales proposal sent to a funnel lead after the call. Public at
// /proposal/<token>; content is the editable page body (tiers, recap, terms).
model Proposal {
  id            String         @id @default(cuid())
  leadId        String
  lead          FunnelLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  token         String         @unique
  title         String
  content       Json           // { headline, intro, recap[], problems[], tiers[], whyNow, terms[], nextSteps[] }
  reportToken   String?        // StoreProof report linked from the proposal
  validUntil    DateTime?
  status        String         @default("draft") // draft | sent | accepted | declined
  acceptedTier  String?
  acceptedNote  String?
  acceptedAt    DateTime?
  sentAt        DateTime?
  viewCount     Int            @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  views         ProposalView[]

  @@index([leadId])
  @@map("proposals")
}

model ProposalView {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  viewedAt    DateTime @default(now())
  ip          String?
  country     String?
  city        String?
  os          String?
  browser     String?
  durationSec Int?
  scrollPct   Int?
  clicks      String?

  @@index([proposalId])
  @@map("proposal_views")
}
